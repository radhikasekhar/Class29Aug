# PostgreSQL
POSTGRES_DB=rag
POSTGRES_USER=rag
# Change this value in an untracked .env file for a non-default local setup.
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_PORT=5433

# API database connection. Defaults to the values above when DB_* is not set.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=rag
DB_USER=rag
DB_PASSWORD=rag_dev_password

# Ollama
OLLAMA_BASE_URL=http://ollama:11434

# AI providers. OpenAI is optional and should remain empty for an Ollama-only setup.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LLM_PROVIDER=ollama
LLM_MODEL=qwen3

# Retrieval and chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=8

# Application ports
RAG_API_PORT=8000
RAG_UI_PORT=8501